{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Correo Boxplot",
  "version": "0.1.0",
  "identifier": "com.editorialhuellas.correoboxplot",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Correo Boxplot",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundThrottling": "throttle"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'self'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"],
    "resources": {
      "../vendor/libsqlite3-sys-0.38.2-sqlcipher-4.17/LICENSE": "licenses/libsqlite3-sys-0.38.2-LICENSE",
      "../vendor/libsqlite3-sys-0.38.2-sqlcipher-4.17/sqlcipher/LICENSE": "licenses/SQLCipher-4.17.0-LICENSE",
      "../vendor/licenses/OpenSSL-3.6.3-LICENSE.txt": "licenses/OpenSSL-3.6.3-LICENSE.txt",
      "../vendor/licenses/openssl-src-LICENSE-APACHE": "licenses/openssl-src-LICENSE-APACHE",
      "../vendor/licenses/openssl-src-LICENSE-MIT": "licenses/openssl-src-LICENSE-MIT",
      "../vendor/licenses/rusqlite-0.40.2-LICENSE": "licenses/rusqlite-0.40.2-LICENSE"
    }
  }
}
