flowchart TD
    User(["Usuario"])

    subgraph Presentation["Presentation · src/components"]
        UI["Vue 3<br/>render seguro<br/>DOMPurify + iframe sandbox + CSP"]
    end

    subgraph Application["Application · src/app"]
        State["Pinia<br/>estado efímero y proyecciones"]
    end

    subgraph Core["Domain + Ports"]
        Domain["Domain<br/>tipos y semántica<br/>sin infraestructura"]
        ReadRepo["ReadRepository · P-01 CLOSED<br/>pure committed-state reads"]
        SyncPort["SyncPort · P-02 CLOSED<br/>semantic atomic transitions"]
        ChangeSource["LocalChangeSource<br/>P-03 IMPLEMENTED · review pending<br/>invalidación post-commit"]

        ReadRepo -.->|"tipos"| Domain
        SyncPort -.->|"tipos"| Domain
        ChangeSource -.->|"tipos"| Domain
    end

    subgraph TauriAdapters["Adapters TypeScript · src/adapters/tauri"]
        ReadAdapter["TauriReadRepository<br/>satisface ReadRepository"]
        SyncAdapter["TauriSyncPort<br/>satisface SyncPort"]
    end

    subgraph Native["Tauri / Rust Local Engine · MVP ACTUAL"]
        IPC{{"Tauri IPC boundary<br/>capabilities default-deny<br/>Isolation Pattern"}}
        Commands["Comandos Rust<br/>semánticos y validados"]
        Rust["Local Engine Rust<br/>queries · transacciones · migraciones"]
        DB[("SQLite + SQLCipher<br/>fuente local de verdad para UI")]
        Secret["Secure store del SO"]
        DEK["DEK aleatoria 32 bytes<br/>solo Rust"]
        Events["Eventos Tauri<br/>cambio local"]

        IPC --> Commands
        Commands --> Rust
        Secret --> DEK
        DEK --> Rust
        Rust --> DB
        Rust --> Events
    end

    subgraph Background["Worker TypeScript · Tauri MVP"]
        Coordinator["Coordinator<br/>src/sync"]
        Outbox["Outbox<br/>src/sync"]
        JMAP["JMAP Client<br/>src/jmap<br/>fetch + WebSocket"]
        Token["Token JMAP<br/>solo memoria"]

        Coordinator --> JMAP
        Outbox --> JMAP
        Token --> JMAP
    end

    Browser["Navegador del sistema<br/>Passkey/WebAuthn"]
    Server[("Servidor propio JMAP<br/>autoridad remota<br/>FUERA DE ALCANCE")]
    WebFuture["Adapters Web/PWA futuros<br/>DEFERRED<br/>fuera del MVP actual"]
    LocalNote["LocalReady + RemoteAnonymous es válido<br/>Passkey auth ≠ clave SQLCipher"]

    User --> UI
    UI --> State
    State --> ReadRepo
    State -->|"write use-cases"| SyncPort
    ReadRepo --> ReadAdapter
    ReadAdapter -->|"invoke() semántico"| IPC

    Events --> ChangeSource
    ChangeSource -.->|"Application relee"| State

    Coordinator --> SyncPort
    Outbox --> SyncPort
    SyncPort --> SyncAdapter
    SyncAdapter -->|"invoke() semántico"| IPC

    Browser -->|"auth remota"| Token
    JMAP <-->|"JMAP HTTPS"| Server
    Server -.->|"push StateChange"| JMAP

    ReadRepo -.->|"mismo port"| WebFuture
    SyncPort -.->|"mismo port"| WebFuture

    DB --- LocalNote
    Token --- LocalNote

    classDef presentation fill:#fff7e6,stroke:#9a6700,color:#222;
    classDef application fill:#eef7ff,stroke:#336b99,color:#222;
    classDef core fill:#f2efff,stroke:#6554a4,color:#222;
    classDef adapter fill:#e8f4ff,stroke:#246b91,color:#222;
    classDef sync fill:#eef7ff,stroke:#336b99,color:#222;
    classDef remote fill:#e8f4ff,stroke:#1b7698,color:#222;
    classDef secure fill:#eaf7ea,stroke:#2f7d32,color:#222;
    classDef deferred fill:#f4f4f4,stroke:#777,stroke-dasharray:5 5,color:#444;
    classDef boundary fill:#fff4cc,stroke:#8a6d00,color:#222;
    classDef external fill:#fafafa,stroke:#666,stroke-dasharray:5 5,color:#222;
    class UI presentation;
    class State application;
    class Coordinator,Outbox sync;
    class JMAP remote;
    class Domain,ReadRepo,SyncPort,ChangeSource core;
    class ReadAdapter,SyncAdapter adapter;
    class Commands,Rust,DB,Secret,DEK,Token secure;
    class WebFuture deferred;
    class IPC,LocalNote boundary;
    class Server external;
