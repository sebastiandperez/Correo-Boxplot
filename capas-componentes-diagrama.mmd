flowchart TD
    User([Usuario])

    subgraph Shared["Capas compartidas por ambas entregas"]
        UI["Presentación<br/>Vue 3 + Composition API<br/>DOMPurify antes de insertar HTML"]
        State["Estado de aplicación<br/>Pinia"]
        Repository["Interfaz Repository única<br/>lecturas locales + comandos locales"]
    end

    Split{"BIFURCACIÓN<br/>entrega elegida al construir/iniciar"}

    subgraph TauriDelivery["Entrega Tauri v2"]
        TauriEngine["Motor Tauri / Rust<br/>IPC con Isolation Pattern<br/>SQLite nativo + SQLCipher"]
    end

    subgraph WebDelivery["Entrega Web / PWA"]
        WebEngine["Motor Web<br/>wa-sqlite + OPFS + SQLCipher<br/>[PENDIENTE] integración SQLCipher y contexto de background"]
    end

    Merge{{"CONVERGENCIA LÓGICA<br/>mismas operaciones de sincronización JMAP<br/>[PENDIENTE] implementación compartida o dos implementaciones conformes"}}

    subgraph JmapLayer["Cliente JMAP y sincronización en background"]
        Sync["Coordinador de sincronización<br/>State / changes / queryChanges"]
        Outbox["Procesador de Pending Mutations<br/>envíos y cambios optimistas"]
        JMAP["Transporte JMAP real<br/>métodos por HTTPS<br/>push StateChange por WebSocket"]

        Sync -->|Solicitudes incrementales| JMAP
        Outbox -->|Mutaciones JMAP| JMAP
    end

    Server[("Servidor propio JMAP<br/>FUERA DE ALCANCE")]
    LocalOnly["La ruta de primer plano termina en SQLite local.<br/>Resultados y cambios vuelven a Pinia por Repository.<br/>La UI no espera a la red para responder."]

    User -->|Interactúa| UI
    UI -->|Lee estado / emite intenciones| State
    State -->|Usa solamente este contrato| Repository
    Repository --> Split

    Split -->|Desktop| TauriEngine
    Split -->|Web / PWA| WebEngine

    TauriEngine -.->|Solo background: cursores, pendientes y resultados| Merge
    WebEngine -.->|Solo background: cursores, pendientes y resultados| Merge
    Merge --> Sync
    Merge --> Outbox

    JMAP -->|JMAP sobre HTTPS| Server
    Server -.->|WebSocket: StateChange, no contenido completo| JMAP

    Repository --- LocalOnly

    classDef boundary fill:#f7f7f7,stroke:#666,stroke-dasharray:5 5,color:#222;
    classDef decision fill:#fff4cc,stroke:#9a7300,color:#222;
    classDef security fill:#eef7ff,stroke:#336b99,color:#222;
    class Server,LocalOnly boundary;
    class Split,Merge decision;
    class UI,TauriEngine,WebEngine security;
